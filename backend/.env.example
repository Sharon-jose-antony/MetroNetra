# MetroNetra — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="MetroNetra"
APP_ENV=development
DEBUG=true
SECRET_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./metronetra.db

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,bmp,tiff

# ── Image Quality Thresholds ─────────────────────────────────────────────────
IQ_MIN_RESOLUTION_PX=400
IQ_BLUR_THRESHOLD=80.0
IQ_CONTRAST_THRESHOLD=30.0
IQ_GLARE_THRESHOLD=0.08

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_PROVIDER=paddleocr
OCR_LANGUAGES=en
OCR_MIN_CONFIDENCE=0.30

# ── Confidence Weights ────────────────────────────────────────────────────────
CONF_WEIGHT_QUALITY=0.20
CONF_WEIGHT_OCR=0.35
CONF_WEIGHT_EXTRACTION=0.35
CONF_WEIGHT_APPLICABILITY=0.10

# ── Report ────────────────────────────────────────────────────────────────────
REPORTS_DIR=./data/reports

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000
